// VegaStack Pages — self-host Cloudflare Worker example.
//
// Copy this file to `apps/web/wrangler.jsonc` (the production deploy
// already lives there for the managed deployment at pages.vegastack.com)
// and replace the placeholder ids with your own Cloudflare resource
// values. Then:
//
//   pnpm install
//   pnpm --filter @vegastack/pages-web build
//   pnpm exec wrangler d1 migrations apply <database-name> --remote
//
//   # Email: AWS SES (primary) — verify the sending domain in SES first
//   pnpm exec wrangler secret put AWS_REGION
//   pnpm exec wrangler secret put AWS_ACCESS_KEY_ID
//   pnpm exec wrangler secret put AWS_SECRET_ACCESS_KEY
//
//   # Email: Cloudflare send_email binding (fallback / inbound reply path)
//   # Visit https://dash.cloudflare.com/?to=/:account/email/send to verify
//   # the From: address(es) declared under `send_email[].allowed_sender_addresses`.
//
//   pnpm exec wrangler secret put VPG_GITHUB_APP_PRIVATE_KEY
//   pnpm exec wrangler secret put VPG_GITHUB_APP_CLIENT_ID
//   pnpm exec wrangler secret put VPG_GITHUB_APP_CLIENT_SECRET
//   pnpm exec wrangler secret put VPG_SETUP_TOKEN
//   pnpm exec wrangler secret put ASTRO_KEY             # Astro server-island prop crypto
//   pnpm exec wrangler deploy
//
// ASCII architecture (one Worker, Smart Placement):
//
//   Browser / MCP / CLI
//          │
//          ▼  HTTPS
//   ┌────────────────────────────┐
//   │ Cloudflare edge            │  caches.default (Workers Cache API)
//   │ + Rate Limiting Rules      │  for /p/[slug], /f/[slug], /docs/*
//   └─────────────┬──────────────┘
//                 │  cache miss
//                 ▼
//   ┌─────────────────────────────────────────────────────────┐
//   │ Single Cloudflare Worker  (placement: smart)            │
//   │  - Astro 6.3 SSR  •  @astrojs/cloudflare 13.5           │
//   │  - compatibility_flags: ["nodejs_compat"]               │
//   │  - observability + tracing → Sentry (OTLP, dashboard)   │
//   │  - middleware: auth + CSRF + rate-limit + security      │
//   │  - services: packages/services/* over D1                │
//   │  - nav: Astro <ClientRouter /> + transition:persist     │
//   └─┬───────────────┬───────────────┬───────────────┬───────┘
//     │               │               │               │
//     ▼               ▼               ▼               ▼
//   ┌────┐         ┌─────┐         ┌────────┐     ┌─────────────┐
//   │ D1 │         │ R2  │         │ IMAGES │     │ ACTIONS_RL  │
//   │ DB │         │ CONT│         │binding │     │ (rate limit)│
//   └────┘         └─────┘         └────────┘     └─────────────┘
//
// Email: AWS SES (primary) + Cloudflare `send_email` binding (fallback
// and the canonical reply path inside Email Routing's `email()` inbound
// handler). `VPG_EMAIL_PROVIDER=auto` picks SES when AWS_* secrets are
// present, falls back to the Cloudflare binding when only EMAIL is
// bound. Inbound delivery (e.g., replies to magic-link emails landing
// in support@) is handled by Cloudflare Email Routing rules — configure
// them in the Cloudflare dashboard or in this Worker's `email()` export.
// Sessions: auth lives in the D1 `auth_sessions` table.

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vegastack-pages",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "workers_dev": false,
  "routes": [{ "pattern": "pages.example.com", "custom_domain": true }],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vegastack-pages",
      "database_id": "<generated by `wrangler d1 create`>",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],

  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "vegastack-pages-content",
    },
  ],

  // Cloudflare send_email binding. Acts as a fallback when AWS_* aren't
  // set and as the reply path from any inbound Email Routing handler.
  // The From: addresses below must be verified in the Cloudflare
  // dashboard before the binding accepts a send.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["notifications@example.com"],
    },
  ],

  "ratelimits": [
    {
      "name": "ACTIONS_RL",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],

  // Cron triggers:
  //   "0 3 * * *"  — nightly GitHub backup sync.
  //   "30 3 * * *" — nightly search-index reconciler.
  "triggers": { "crons": ["0 3 * * *", "30 3 * * *"] },

  "vars": {
    "VPG_RUNTIME": "cloudflare",
    "VPG_DEPLOYMENT_MODE": "self_hosted",
    "VPG_PUBLIC_SIGNUP": "false",
    "VPG_BASE_URL": "https://pages.example.com",
    "VPG_HOME_MODE": "landing",
    "VPG_EMAIL_FROM": "notifications@example.com",
    "VPG_EMAIL_FROM_NAME": "VegaStack Pages",
    // `auto`: AWS SES if AWS_* secrets are set, else Cloudflare
    // send_email binding, else dev/console mode.
    "VPG_EMAIL_PROVIDER": "auto",
    "VPG_GITHUB_APP_ID": "",
    "VPG_GITHUB_APP_SLUG": "",
    "VPG_GITHUB_SYNC_CRON": "0 3 * * *",
  },
}
