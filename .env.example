# VegaStack Pages local development
#
# Copy this file to .env.local only when you want persistent local defaults.
# All values can also be passed inline to commands.

# The local Astro dev server listens on 4322 by default in this repo.
PORT=4322

# Public browser origin used for generated links and auth callbacks.
# Use localhost when not using a tunnel:
# VPG_BASE_URL=http://127.0.0.1:4322
#
# Use your own tunnel/domain only when exposing the local dev server.
# `VPG_TUNNEL_URL` adds the tunnel hostname to Vite's allowed-hosts so
# the dev server accepts it (in addition to localhost).
# VPG_BASE_URL=https://<your-tunnel-url>
# VPG_TUNNEL_URL=https://<your-tunnel-url>
VPG_BASE_URL=http://127.0.0.1:4322

# Local Node backend. The single VPG_RUNTIME flag drives adapter
# selection (the legacy VPG_ADAPTER name is no longer read).
VPG_RUNTIME=node
VPG_DEPLOYMENT_MODE=self_hosted
VPG_PUBLIC_SIGNUP=false
VPG_DEMO_SEED=false

# Local setup/auth defaults.
VPG_SETUP_TOKEN=dev-setup-token
VPG_LOCAL_ADMIN_EMAIL=dev@example.com

# Email provider for outbound transactional mail. `console` logs the
# magic link to stdout (with token redacted) for local dev. In
# production set this to `aws_ses` (recommended) or `cloudflare` and
# provide the matching secrets:
#   aws_ses     → AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
#   cloudflare  → the `EMAIL` send_email binding in wrangler.jsonc
VPG_EMAIL_PROVIDER=console

# Optional GitHub App for workspace backup sync. Leave blank to skip.
VPG_GITHUB_APP_ID=
VPG_GITHUB_APP_SLUG=
VPG_GITHUB_APP_PRIVATE_KEY=
VPG_GITHUB_APP_CLIENT_ID=
VPG_GITHUB_APP_CLIENT_SECRET=

# Local persistence defaults used by pnpm dev.
VPG_STATE_DIR=.vegastack-pages/local/state
VPG_SQLITE_PATH=.vegastack-pages/local/state/vegastack-pages.sqlite
VPG_OBJECT_STORE_DIR=.vegastack-pages/local/objects
