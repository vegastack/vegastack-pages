---
import { SidebarWorkspace } from "./SidebarWorkspace";
import { SidebarUserPill } from "./SidebarUserPill";
import SidebarTreeNode from "./SidebarTreeNode.astro";

type FolderRecord = {
  id: string;
  slugId: string;
  name: string;
  path: string;
  parentFolderId: string | null;
};

type PageRecord = {
  id: string;
  slugId: string;
  title: string;
  folderPath: string | null;
};

type Workspace = { id: string; name: string; slug: string };
type User = { id: string; email: string; displayName: string };

interface Props {
  workspace: Workspace;
  workspaces: Workspace[];
  currentUser: User;
  pages: PageRecord[];
  folders: FolderRecord[];
  canWrite?: boolean;
  currentPageId?: string;
  currentFolderId?: string;
  initialFavoriteIds?: string[];
  treeVersion?: string | null;
}

const {
  workspace,
  workspaces,
  currentUser,
  pages,
  folders,
  canWrite = false,
  currentPageId,
  currentFolderId,
  initialFavoriteIds = [],
  treeVersion = null,
} = Astro.props;

type FolderNode = {
  folder: FolderRecord;
  children: FolderNode[];
  pages: PageRecord[];
};

// Parse persisted folder overrides from the cookie so SSR opens/closes the
// `<details>` elements that the user has explicitly toggled. Without this the
// folder tree visibly snaps to its persisted state on hydrate. Cookie format:
//   o:<id>,<id>|c:<id>,<id>
// Sections may be omitted; ids that aren't valid folders in this workspace are
// just ignored.
const folderOverrides = new Map<string, "open" | "closed">();
{
  const raw = Astro.cookies.get("vpg_folders")?.value;
  if (raw) {
    for (const section of raw.split("|")) {
      const idx = section.indexOf(":");
      if (idx <= 0) continue;
      const kind = section.slice(0, idx);
      const state = kind === "o" ? "open" : kind === "c" ? "closed" : null;
      if (!state) continue;
      for (const id of section.slice(idx + 1).split(",")) {
        if (id) folderOverrides.set(id, state);
      }
    }
  }
}

const folderById = new Map<string, FolderNode>();
folders.forEach((folder) => {
  folderById.set(folder.id, { folder, children: [], pages: [] });
});

const rootFolders: FolderNode[] = [];
folders.forEach((folder) => {
  const node = folderById.get(folder.id);
  if (!node) return;
  if (folder.parentFolderId && folderById.has(folder.parentFolderId)) {
    folderById.get(folder.parentFolderId)!.children.push(node);
  } else {
    rootFolders.push(node);
  }
});

pages.forEach((page) => {
  if (!page.folderPath) return;
  const owner = [...folderById.values()].find(
    (node) => node.folder.path === page.folderPath,
  );
  if (owner) owner.pages.push(page);
});

const rootPages = pages.filter((page) => !page.folderPath);
const pageById = new Map(pages.map((page) => [page.id, page]));
const favoritePages = initialFavoriteIds
  .map((id) => pageById.get(id))
  .filter((page): page is PageRecord => Boolean(page));
const initialsOf = (name: string) =>
  name
    .split(/\s+/)
    .map((p) => p[0] ?? "")
    .join("")
    .slice(0, 2)
    .toUpperCase() || "WS";
const userInitials = initialsOf(currentUser.displayName);
const navCacheCookieName = `vpg_tree_${workspace.id.replace(/[^a-zA-Z0-9_-]/g, "_")}`;
const navCacheValue = treeVersion ? `${currentUser.id}:${treeVersion}` : "";
const navCacheKey = treeVersion
  ? `vpg:sidebar:${workspace.id}:${currentUser.id}:${treeVersion}`
  : "";
// Keep the server-rendered navigation as the source of truth. The previous
// private sidebar HTML cache could reconstruct a different tree shape in
// browsers that had a stale version cookie/sessionStorage entry, so page
// navigation became browser-state dependent.
const canUseCachedNav = false;
---

<aside
  class="vpg-shell-sidebar"
  id="vpg-sidebar"
  data-workspace-id={workspace.id}
  data-open="false"
  aria-label="Workspace navigation"
>
  <div class="vpg-sidebar-head">
    <div class="vpg-sidebar-brand-row">
      <SidebarWorkspace
        client:load
        current={workspace}
        workspaces={workspaces}
      />
      {
        canWrite && (
          <div class="vpg-sidebar-create-slot" aria-label="Create new">
            <button
              type="button"
              class="vpg-button vpg-button-icon vpg-button-ghost"
              data-vpg-create-trigger
              data-folder-path=""
              data-can-create-subfolder="false"
              aria-label="Create page or folder"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14" />
                <path d="M12 5v14" />
              </svg>
            </button>
          </div>
        )
      }
    </div>
    <button
      type="button"
      class="vpg-sidebar-search"
      data-vpg-sidebar-search
      aria-label="Search workspace"
    >
      <svg
        class="vpg-sidebar-search-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <span class="vpg-sidebar-search-label">Search</span>
      <kbd class="vpg-sidebar-search-kbd" aria-hidden="true">
        <span>⌘</span><span>K</span>
      </kbd>
    </button>
  </div>

  <div
    class="vpg-sidebar-scroll"
    data-vpg-sidebar-scroll
    data-nav-cache-key={navCacheKey || undefined}
    data-nav-cache-cookie={navCacheCookieName}
    data-nav-cache-value={navCacheValue || undefined}
    data-workspace-id={workspace.id}
    data-current-page-id={currentPageId || ""}
    data-current-folder-id={currentFolderId || ""}
    data-can-write={canWrite ? "true" : "false"}
    data-nav-cache-hit={canUseCachedNav ? "true" : "false"}
  >
    {
      !canUseCachedNav && (
        <>
          <section
            class="vpg-sidebar-section"
            data-vpg-sidebar-favorites
            data-workspace-id={workspace.id}
            hidden={favoritePages.length === 0}
          >
            <header class="vpg-sidebar-section-head">
              <span class="vpg-sidebar-section-label">Favorites</span>
            </header>
            <ul class="vpg-sidebar-tree" data-vpg-sidebar-favorites-list>
              {favoritePages.map((page) => (
                <li data-vpg-favorite-page-id={page.id}>
                  <a
                    class="vpg-sidebar-row"
                    href={`/p/${page.slugId}`}
                    data-astro-prefetch="hover"
                    data-active={page.id === currentPageId ? "true" : undefined}
                  >
                    <span class="vpg-sidebar-row-icon" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.9"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" x2="8" y1="13" y2="13" />
                        <line x1="16" x2="8" y1="17" y2="17" />
                      </svg>
                    </span>
                    <span class="vpg-sidebar-row-label">{page.title}</span>
                    <span class="vpg-sidebar-row-trail" aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
          </section>

          {rootPages.length > 0 && (
            <section class="vpg-sidebar-section">
              <header class="vpg-sidebar-section-head">
                <span class="vpg-sidebar-section-label">Pages</span>
                {canWrite && (
                  <div class="vpg-sidebar-section-action">
                    <button
                      type="button"
                      class="vpg-button vpg-button-icon vpg-button-ghost"
                      data-vpg-create-trigger
                      data-folder-path=""
                      data-can-create-subfolder="false"
                      aria-label="Create page or folder"
                    >
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M5 12h14" />
                        <path d="M12 5v14" />
                      </svg>
                    </button>
                  </div>
                )}
              </header>
              <ul class="vpg-sidebar-tree">
                {rootPages.map((page) => (
                  <li>
                    <a
                      class="vpg-sidebar-row"
                      href={`/p/${page.slugId}`}
                      data-astro-prefetch
                      data-active={
                        page.id === currentPageId ? "true" : undefined
                      }
                    >
                      <span class="vpg-sidebar-row-icon" aria-hidden="true">
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.9"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                          <polyline points="14 2 14 8 20 8" />
                          <line x1="16" x2="8" y1="13" y2="13" />
                          <line x1="16" x2="8" y1="17" y2="17" />
                        </svg>
                      </span>
                      <span class="vpg-sidebar-row-label">{page.title}</span>
                      <span class="vpg-sidebar-row-trail" aria-hidden="true" />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {rootFolders.map((node) => (
            <section class="vpg-sidebar-section">
              <header class="vpg-sidebar-section-head vpg-sidebar-folder-section-head">
                <a
                  class="vpg-sidebar-section-label vpg-sidebar-section-label-link"
                  href={`/f/${node.folder.slugId}`}
                  data-astro-prefetch
                >
                  {node.folder.name}
                </a>
                {canWrite && (
                  <div class="vpg-sidebar-section-action">
                    <button
                      type="button"
                      class="vpg-button vpg-button-icon vpg-button-ghost"
                      data-vpg-create-trigger
                      data-folder-id={node.folder.id}
                      data-folder-path={node.folder.path}
                      data-can-create-subfolder="true"
                      aria-label="Create page or folder"
                    >
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M5 12h14" />
                        <path d="M12 5v14" />
                      </svg>
                    </button>
                  </div>
                )}
              </header>
              <ul class="vpg-sidebar-tree">
                {canWrite &&
                  node.pages.length === 0 &&
                  node.children.length === 0 && (
                    <li class="vpg-sidebar-empty-folder">
                      <button
                        type="button"
                        class="vpg-button vpg-button-sm vpg-button-ghost vpg-sidebar-empty-folder-action"
                        data-vpg-create-trigger
                        data-folder-id={node.folder.id}
                        data-folder-path={node.folder.path}
                        data-can-create-subfolder="true"
                        aria-label={`Create in ${node.folder.path}`}
                      >
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M5 12h14" />
                          <path d="M12 5v14" />
                        </svg>
                        <span>New</span>
                      </button>
                    </li>
                  )}
                {node.pages.map((page) => (
                  <li>
                    <a
                      class="vpg-sidebar-row"
                      href={`/p/${page.slugId}`}
                      data-astro-prefetch
                      data-active={
                        page.id === currentPageId ? "true" : undefined
                      }
                    >
                      <span class="vpg-sidebar-row-icon" aria-hidden="true">
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.9"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                          <polyline points="14 2 14 8 20 8" />
                          <line x1="16" x2="8" y1="13" y2="13" />
                          <line x1="16" x2="8" y1="17" y2="17" />
                        </svg>
                      </span>
                      <span class="vpg-sidebar-row-label">{page.title}</span>
                      <span class="vpg-sidebar-row-trail" aria-hidden="true" />
                    </a>
                  </li>
                ))}
                {node.children.map((child) => (
                  <SidebarTreeNode
                    node={child}
                    currentPageId={currentPageId}
                    currentFolderId={currentFolderId}
                    folderOverrides={folderOverrides}
                  />
                ))}
              </ul>
            </section>
          ))}
        </>
      )
    }
  </div>

  <div class="vpg-sidebar-foot">
    <nav class="vpg-sidebar-foot-nav" aria-label="Workspace utilities">
      <a class="vpg-sidebar-foot-link" href="/app/settings/general">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"
          ></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
        <span>Settings</span>
      </a>
      <a class="vpg-sidebar-foot-link" href="/docs">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
          <path d="M12 17h.01"></path>
        </svg>
        <span>Help &amp; docs</span>
      </a>
    </nav>
    <SidebarUserPill
      client:load
      name={currentUser.displayName}
      email={currentUser.email}
      initials={userInitials}
    />
  </div>
</aside>

<div
  class="vpg-shell-backdrop"
  data-vpg-sidebar-backdrop
  data-open="false"
  aria-hidden="true"
>
</div>

<script is:inline>
  (() => {
    if (window.__vpgSidebarInitialized) return;
    window.__vpgSidebarInitialized = true;

    const currentSidebar = () => document.getElementById("vpg-sidebar");
    const currentBackdrop = () =>
      document.querySelector("[data-vpg-sidebar-backdrop]");

    function setOpen(open) {
      const sidebar = currentSidebar();
      const backdrop = currentBackdrop();
      if (!sidebar || !backdrop) return;
      sidebar.dataset.open = open ? "true" : "false";
      backdrop.dataset.open = open ? "true" : "false";
      document
        .querySelectorAll("[data-vpg-sidebar-toggle]")
        .forEach((toggle) => {
          toggle.setAttribute("aria-expanded", String(open));
        });
      document.body.style.overflow = open ? "hidden" : "";
    }

    document.addEventListener("click", (event) => {
      const sidebar = currentSidebar();
      const target = event.target;
      if (!sidebar || !(target instanceof Element)) return;
      const toggle = target.closest("[data-vpg-sidebar-toggle]");
      if (toggle) {
        event.preventDefault();
        setOpen(sidebar.dataset.open !== "true");
        return;
      }
      if (sidebar.contains(target) && target.closest("a[href]")) {
        const isDesktop = window.matchMedia("(min-width: 1024px)").matches;
        if (!isDesktop) setOpen(false);
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (
        target instanceof Element &&
        target.closest("[data-vpg-sidebar-backdrop]")
      ) {
        setOpen(false);
      }
    });
    document.addEventListener("keydown", (event) => {
      const sidebar = currentSidebar();
      if (event.key === "Escape" && sidebar?.dataset.open === "true") {
        setOpen(false);
      }
    });

    // Persisted folder overrides. SSR reads the same cookie and renders the
    // <details> elements with the right `open` attribute, so this script just
    // keeps the cookie + localStorage in sync on toggle. We track the set of
    // explicit overrides (id -> "o" | "c") and serialize as
    //   o:<csv>|c:<csv>
    // matching the format Sidebar.astro parses on the server.
    const FOLDER_COOKIE_KEY = "vpg_folders";
    const folderOverrides =
      window.__vpgFolderOverrides ??
      (() => {
        const map = new Map();
        const prefix = FOLDER_COOKIE_KEY + "=";
        const part = document.cookie
          .split(";")
          .map((s) => s.trim())
          .find((s) => s.startsWith(prefix));
        if (!part) return map;
        for (const section of part.slice(prefix.length).split("|")) {
          const idx = section.indexOf(":");
          if (idx <= 0) continue;
          const kind = section.slice(0, idx);
          const state = kind === "o" ? "o" : kind === "c" ? "c" : null;
          if (!state) continue;
          for (const id of section.slice(idx + 1).split(",")) {
            if (id) map.set(id, state);
          }
        }
        return map;
      })();
    window.__vpgFolderOverrides = folderOverrides;

    function writeFolderCookie() {
      const open = [];
      const closed = [];
      folderOverrides.forEach((state, id) => {
        (state === "o" ? open : closed).push(id);
      });
      const parts = [];
      if (open.length) parts.push("o:" + open.join(","));
      if (closed.length) parts.push("c:" + closed.join(","));
      const value = parts.join("|");
      const secure = window.location.protocol === "https:" ? "; Secure" : "";
      document.cookie =
        FOLDER_COOKIE_KEY +
        "=" +
        value +
        "; path=/; max-age=31536000; samesite=lax" +
        secure;
    }

    function hydrateFolders() {
      let dirty = false;
      document.querySelectorAll("details[data-folder-id]").forEach((node) => {
        if (!(node instanceof HTMLDetailsElement)) return;
        if (node.dataset.hydrated === "true") return;
        node.dataset.hydrated = "true";
        const id = node.dataset.folderId;
        if (!id) return;
        // Legacy backfill: if we have a localStorage entry but no cookie
        // override for this folder, fold it into the override map so the next
        // SSR has it. We don't override the SSR'd `open` here — SSR is already
        // the source of truth via the cookie.
        const localKey = "vpg-folder-" + id;
        if (!folderOverrides.has(id)) {
          const legacy = window.localStorage.getItem(localKey);
          if (legacy === "open" || legacy === "closed") {
            folderOverrides.set(id, legacy === "open" ? "o" : "c");
            dirty = true;
          }
        }
        node.addEventListener("toggle", () => {
          const state = node.open ? "o" : "c";
          folderOverrides.set(id, state);
          writeFolderCookie();
          try {
            window.localStorage.setItem(
              localKey,
              node.open ? "open" : "closed",
            );
          } catch {}
        });
      });
      if (dirty) writeFolderCookie();
    }
    hydrateFolders();
    document.addEventListener("astro:page-load", hydrateFolders);

    function currentFavoritesSection() {
      return document.querySelector("[data-vpg-sidebar-favorites]");
    }

    function currentFavoritesList() {
      return document.querySelector("[data-vpg-sidebar-favorites-list]");
    }

    function favoriteItemFor(pageId) {
      const list = currentFavoritesList();
      if (!list) return null;
      for (const item of list.querySelectorAll("[data-vpg-favorite-page-id]")) {
        if (item.getAttribute("data-vpg-favorite-page-id") === pageId) {
          return item;
        }
      }
      return null;
    }

    function syncFavoritesVisibility() {
      const section = currentFavoritesSection();
      const list = currentFavoritesList();
      if (!(section instanceof HTMLElement) || !list) return;
      section.hidden = list.children.length === 0;
    }

    function createFavoriteItem(detail) {
      if (!detail?.pageId || !detail.slugId || !detail.title) return null;
      const item = document.createElement("li");
      item.setAttribute("data-vpg-favorite-page-id", detail.pageId);

      const link = document.createElement("a");
      link.className = "vpg-sidebar-row";
      link.href = "/p/" + encodeURIComponent(detail.slugId);
      link.setAttribute("data-astro-prefetch", "hover");
      if (window.location.pathname === "/p/" + detail.slugId) {
        link.setAttribute("data-active", "true");
      }

      const icon = document.createElement("span");
      icon.className = "vpg-sidebar-row-icon";
      icon.setAttribute("aria-hidden", "true");
      icon.innerHTML =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" x2="8" y1="13" y2="13"></line><line x1="16" x2="8" y1="17" y2="17"></line></svg>';

      const label = document.createElement("span");
      label.className = "vpg-sidebar-row-label";
      label.textContent = detail.title;

      const trail = document.createElement("span");
      trail.className = "vpg-sidebar-row-trail";
      trail.setAttribute("aria-hidden", "true");

      link.append(icon, label, trail);
      item.append(link);
      return item;
    }

    window.addEventListener("vpg:favorites-changed", (event) => {
      const detail = event.detail;
      const section = currentFavoritesSection();
      const workspaceId =
        section instanceof HTMLElement ? section.dataset.workspaceId : null;
      if (
        detail?.workspaceId &&
        workspaceId &&
        detail.workspaceId !== workspaceId
      ) {
        return;
      }
      if (!detail?.pageId) return;
      const list = currentFavoritesList();
      if (!list) return;

      const existing = favoriteItemFor(detail.pageId);
      if (detail.favorited) {
        if (!existing) {
          const nextItem = createFavoriteItem(detail);
          if (nextItem) list.append(nextItem);
        }
      } else {
        existing?.remove();
      }
      syncFavoritesVisibility();
      cacheSidebarNav();
    });

    function updateSidebarActive(scroll) {
      const currentPath = window.location.pathname;
      const currentPageId = scroll.dataset.currentPageId || "";
      const currentFolderId = scroll.dataset.currentFolderId || "";
      scroll.querySelectorAll("[data-active]").forEach((node) => {
        node.removeAttribute("data-active");
      });
      scroll.querySelectorAll("a[href]").forEach((link) => {
        if (!(link instanceof HTMLAnchorElement)) return;
        if (link.pathname === currentPath) {
          link.setAttribute("data-active", "true");
          const summary = link.closest("summary");
          summary?.setAttribute("data-active", "true");
        }
      });
      if (currentFolderId) {
        const folder = scroll.querySelector(
          `details[data-folder-id="${CSS.escape(currentFolderId)}"] > summary`,
        );
        folder?.setAttribute("data-active", "true");
      }
      if (currentPageId) {
        const favorite = scroll.querySelector(
          `[data-vpg-favorite-page-id="${CSS.escape(currentPageId)}"] a`,
        );
        favorite?.setAttribute("data-active", "true");
      }
    }

    function hydrateCachedSidebarNav() {
      const scroll = document.querySelector("[data-vpg-sidebar-scroll]");
      if (!(scroll instanceof HTMLElement)) return;
      updateSidebarActive(scroll);
    }

    function cacheSidebarNav() {
      // No-op: see `canUseCachedNav` above. Keep this function so existing
      // favorite/change handlers can call it without coupling to cache state.
    }

    hydrateCachedSidebarNav();
    document.addEventListener("astro:page-load", hydrateCachedSidebarNav);
  })();
</script>

{
  canWrite && (
    <script>
      import {initSidebarCreateController} from
      "../scripts/sidebar-create-controller"; initSidebarCreateController();
    </script>
  )
}
