---
type FolderRecord = {
  id: string;
  slugId: string;
  name: string;
  path: string;
  parentFolderId: string | null;
};

type PageRecord = {
  id: string;
  slugId: string;
  title: string;
  folderPath: string | null;
};

type FolderNode = {
  folder: FolderRecord;
  children: FolderNode[];
  pages: PageRecord[];
};

interface Props {
  node: FolderNode;
  currentPageId?: string;
  currentFolderId?: string;
  folderOverrides?: Map<string, "open" | "closed">;
}

const { node, currentPageId, currentFolderId, folderOverrides } = Astro.props;

const isCurrentFolder = currentFolderId === node.folder.id;
const containsCurrentPage = node.pages.some(
  (page) => page.id === currentPageId,
);
const defaultOpen = isCurrentFolder || containsCurrentPage;
const override = folderOverrides?.get(node.folder.id);
const isOpen =
  override === "open" ? true : override === "closed" ? false : defaultOpen;
---

<li>
  <details
    class="vpg-sidebar-folder"
    data-folder-id={node.folder.id}
    open={isOpen}
  >
    <summary
      class="vpg-sidebar-row"
      data-active={isCurrentFolder ? "true" : undefined}
    >
      <span class="vpg-sidebar-folder-chevron" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </span>
      <span class="vpg-sidebar-row-icon" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"
          ></path>
        </svg>
      </span>
      <span class="vpg-sidebar-row-label">{node.folder.name}</span>
      <span class="vpg-sidebar-row-trail" aria-hidden="true"></span>
    </summary>
    <ul class="vpg-sidebar-folder-children">
      {
        node.pages.map((page) => (
          <li>
            <a
              class="vpg-sidebar-row"
              href={`/p/${page.slugId}`}
              data-astro-prefetch
              data-active={page.id === currentPageId ? "true" : undefined}
            >
              <span class="vpg-sidebar-row-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                  <polyline points="14 2 14 8 20 8" />
                  <line x1="16" x2="8" y1="13" y2="13" />
                  <line x1="16" x2="8" y1="17" y2="17" />
                </svg>
              </span>
              <span class="vpg-sidebar-row-label">{page.title}</span>
              <span class="vpg-sidebar-row-trail" aria-hidden="true" />
            </a>
          </li>
        ))
      }
      {
        node.children.map((child) => (
          <Astro.self
            node={child}
            currentPageId={currentPageId}
            currentFolderId={currentFolderId}
            folderOverrides={folderOverrides}
          />
        ))
      }
    </ul>
  </details>
</li>
