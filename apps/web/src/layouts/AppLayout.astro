---
import { Font } from "astro:assets";
import "../styles/global.css";
import "../styles/shell.css";
import { SonnerHost } from "../components/SonnerHost";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  robots?: string;
}

const {
  title = "VegaStack Pages",
  description = "VegaStack Pages is an open-source Agentic Knowledge Base for agent-authored pages, human review, MCP workflows, and self-hosted documentation.",
  canonicalPath,
  robots = "noindex",
} = Astro.props;
const baseUrl = (process.env.VPG_BASE_URL ?? "https://pages.vegastack.com")
  .replace(/\/+$/, "")
  .replace(/\/app$/, "");
const canonicalUrl = canonicalPath
  ? `${baseUrl}${canonicalPath.startsWith("/") ? canonicalPath : `/${canonicalPath}`}`
  : null;

// SSR the persisted theme onto <html> so the first paint matches the user's
// choice. Without this the browser briefly paints dark via the
// `prefers-color-scheme: dark` rule on `:root:not([data-theme])` when the OS
// is dark and the user has picked light (or vice versa). The cookie is set
// by the theme menus alongside localStorage. Default "system" lets the CSS
// keep its existing OS-aware behavior for first-time visitors.
const themeCookie = Astro.cookies.get("vpg-theme")?.value;
const initialTheme =
  themeCookie === "light" || themeCookie === "dark" || themeCookie === "system"
    ? themeCookie
    : "system";
---

<!doctype html>
<html lang="en" data-theme={initialTheme}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="robots" content={robots} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VegaStack Pages" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${baseUrl}/favicon.svg`} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${baseUrl}/favicon.svg`} />

    <script is:inline>
      // Pre-paint: align <html data-theme> with localStorage when it disagrees
      // with the cookie-derived SSR value (e.g. legacy clients with only
      // localStorage). Also backfills the cookie so the next SSR has the
      // right answer and no flash is needed.
      (() => {
        const valid = (v) => v === "light" || v === "dark" || v === "system";
        let stored = null;
        try {
          stored = window.localStorage.getItem("vpg-theme");
        } catch {}
        const theme = valid(stored) ? stored : "system";
        if (document.documentElement.dataset.theme !== theme) {
          document.documentElement.dataset.theme = theme;
        }
        try {
          const prefix = "vpg-theme=";
          const cookie = document.cookie
            .split(";")
            .map((p) => p.trim())
            .find((p) => p.startsWith(prefix));
          const cookieValue = cookie ? cookie.slice(prefix.length) : null;
          if (cookieValue !== theme) {
            const secure =
              window.location.protocol === "https:" ? "; Secure" : "";
            document.cookie = `vpg-theme=${theme}; path=/; max-age=31536000; samesite=lax${secure}`;
          }
        } catch {}
      })();
    </script>

    <script is:inline>
      // Pre-paint: pick the comments-rail width before first paint so the
      // shell grid track and rail visuals match the user's persisted choice.
      // Reads localStorage first, then falls back to the cookie SSR also reads.
      (() => {
        let collapsed = false;
        try {
          const stored = window.localStorage.getItem(
            "vpg_comments_rail_expanded",
          );
          if (stored === "false") collapsed = true;
          else if (stored !== "true") {
            const prefix = "vpg_comments_rail=";
            const part = document.cookie
              .split(";")
              .map((p) => p.trim())
              .find((p) => p.startsWith(prefix));
            if (part && part.slice(prefix.length) === "collapsed") {
              collapsed = true;
            }
          }
        } catch {}
        document.documentElement.dataset.commentsRail = collapsed
          ? "collapsed"
          : "open";
      })();
    </script>

    {
      /* Astro Fonts API (astro:assets) emits the @font-face block and optimized
        metric-matched fallback face per `fonts: [...]` in astro.config.mjs.
        Preload only the critical Latin sans file; the variable file covers
        every UI/prose weight while avoiding a second latin-ext preload. */
    }
    <Font
      cssVariable="--font-geist"
      preload={[{ subset: "latin", style: "normal", weight: "400" }]}
    />
    <Font cssVariable="--font-geist-mono" />

    <script is:inline>
      (() => {
        const unsafe = new Set(["POST", "PUT", "PATCH", "DELETE"]);
        const readCookie = (name) => {
          const prefix = `${name}=`;
          return (
            document.cookie
              .split(";")
              .map((part) => part.trim())
              .find((part) => part.startsWith(prefix))
              ?.slice(prefix.length) ?? ""
          );
        };
        const sameOriginUrl = (input) => {
          const value = typeof input === "string" ? input : input?.url;
          try {
            return (
              new URL(value, window.location.href).origin ===
              window.location.origin
            );
          } catch {
            return false;
          }
        };
        const nativeFetch = window.fetch.bind(window);
        let mintInFlight = null;
        const mintCsrfCookie = () => {
          if (mintInFlight) return mintInFlight;
          mintInFlight = nativeFetch("/api/csrf", {
            method: "GET",
            credentials: "same-origin",
            cache: "no-store",
          })
            .catch(() => undefined)
            .finally(() => {
              mintInFlight = null;
            });
          return mintInFlight;
        };
        const withCsrfHeader = (init, input, token) => {
          const headers = new Headers(
            init.headers ??
              (input instanceof Request ? input.headers : undefined),
          );
          if (!headers.has("x-vpg-csrf-token"))
            headers.set("x-vpg-csrf-token", token);
          return { ...init, headers };
        };
        window.fetch = async (input, init = {}) => {
          const method = String(
            init.method ?? (input instanceof Request ? input.method : "GET"),
          ).toUpperCase();
          if (!unsafe.has(method) || !sameOriginUrl(input)) {
            return nativeFetch(input, init);
          }
          let token = readCookie("vpg_csrf");
          if (!token) {
            // Cookie was wiped or never seeded for this tab — mint one and retry.
            await mintCsrfCookie();
            token = readCookie("vpg_csrf");
          }
          if (!token) return nativeFetch(input, init);
          return nativeFetch(input, withCsrfHeader(init, input, token));
        };
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <SonnerHost client:load />
  </body>
</html>
