---
import { AppError, hasPermission } from "@vegastack/pages-core";
import { CommandPalette } from "../../components/CommandPalette";
import FolderPageList from "../../components/FolderPageList.astro";
import MobileTabBar from "../../components/MobileTabBar.astro";
import PageHeader from "../../components/PageHeader.astro";
import PublicFolderSidebar from "../../components/PublicFolderSidebar.astro";
import { SharePasswordPrompt } from "../../components/SharePasswordPrompt";
import Sidebar from "../../components/Sidebar.astro";
import type {
  BreadcrumbSegment,
  BreadcrumbSibling,
} from "../../components/BreadcrumbCascade";
import {
  getRequestActor,
  resolveActorPermission,
  resolveFolderAccess,
  resolveFolderActorPermission,
  type PageAccess,
} from "../../lib/access";
import {
  canReadFolderOrVisibleDescendants,
  listVisibleFoldersForActor,
} from "../../lib/workspace-visibility";
import { buildWorkspaceNavigation } from "../../lib/workspace-navigation";
import { readInitialTheme } from "../../lib/theme";
import {
  comments as commentsService,
  favorites as favoritesService,
  folders as foldersService,
  pages as pagesService,
  workspaces as workspacesService,
} from "@vegastack/pages-services";
import { buildServiceContext } from "../../lib/service-context";
import AppLayout from "../../layouts/AppLayout.astro";
import "../../styles/docs.css";

export const prerender = false;

const { slugId } = Astro.params;
const earlyCtxResult = await buildServiceContext({
  cookies: Astro.cookies,
  request: Astro.request,
});
const folder = slugId
  ? await foldersService.getBySlugId(earlyCtxResult.ctx, slugId)
  : null;
if (!folder) return new Response("Folder not found", { status: 404 });

// Phase G fast path: anonymous + baked folder-publication artifact in
// R2 → serve from Cache API. Members fall through to the SSR sidebar
// view below.
{
  const {
    isAnonymousPublicRequest,
    servePublishedArtifact,
    verifyPasswordCookie,
  } = await import("../../lib/publication-cache");
  if (isAnonymousPublicRequest(Astro.cookies)) {
    const { publications: publicationsService } =
      await import("@vegastack/pages-services");
    const { buildServiceContext } = await import("../../lib/service-context");
    const { ctx } = await buildServiceContext({
      cookies: Astro.cookies,
      request: Astro.request,
      workspaceId: folder.workspaceId,
    });
    const publication = await publicationsService.findForResource(ctx, {
      workspaceId: folder.workspaceId,
      resourceType: "folder",
      resourceId: folder.id,
    });
    if (
      publication &&
      !publication.revokedAt &&
      publication.latestArtifactKey
    ) {
      const passwordOk = await verifyPasswordCookie(Astro.cookies, publication);
      if (passwordOk) {
        const served = await servePublishedArtifact({
          ctx,
          publication,
          request: Astro.request,
        });
        if (served) return served.response;
      }
    }
  }
}

let access: PageAccess | null = null;
let passwordPrompt: { publicationId: string } | null = null;
try {
  access = await resolveFolderAccess({
    cookies: Astro.cookies,
    url: Astro.url,
    folder,
    required: "read",
  });
} catch (error) {
  if (
    error instanceof AppError &&
    error.code === "PUBLICATION_PASSWORD_REQUIRED"
  ) {
    const publicationId =
      typeof error.details?.publication_id === "string"
        ? error.details.publication_id
        : null;
    if (publicationId) passwordPrompt = { publicationId };
  }
  if (!passwordPrompt)
    return new Response("Permission denied", { status: 403 });
}

const folderAccess: PageAccess = access ?? {
  actor: await getRequestActor(Astro.cookies),
  permission: "none",
  publicationId: null,
  publication: null,
  guestNameRequired: false,
};
const actor = folderAccess.actor;
const isPublicPublication = Boolean(
  passwordPrompt || (folderAccess.publicationId && !actor.user),
);
const currentFolderId = folder.id;
if (
  !isPublicPublication &&
  !(await canReadFolderOrVisibleDescendants(actor, currentFolderId))
) {
  return new Response("Permission denied", { status: 403 });
}

// Public folder publication caching — mirrors /p/[slugId].astro. Public
// + indexable shares get long shared-cache; password-gated shares get a
// short private cache keyed by Cookie; authenticated workspace views are
// never edge-cached. ETag combines workspaceId + folder updatedAt +
// publication record + password-state, so any structural or auth change
// busts the cache without us purging by URL.
//
// Audit reference: docs/audit-cycle-3-findings.md F-004.
if (isPublicPublication && folderAccess.publication) {
  const pub = folderAccess.publication;
  const passwordGated = Boolean(pub.passwordHash);
  const indexable = Boolean(pub.indexingEnabled);
  const etag = `W/"folder.${folder.id}.${Date.parse(folder.updatedAt).toString(36)}.${Date.parse(pub.updatedAt).toString(36)}.${passwordGated ? "p" : "o"}"`;
  Astro.response.headers.set("ETag", etag);
  // Three cache policies — see /p/[slugId].astro for the rationale.
  let cacheControl: string;
  if (passwordGated) {
    cacheControl = "private, max-age=60";
    Astro.response.headers.set("Vary", "Cookie");
  } else if (indexable) {
    cacheControl =
      "public, max-age=300, s-maxage=31536000, stale-while-revalidate=60";
  } else {
    cacheControl =
      "public, max-age=60, s-maxage=300, stale-while-revalidate=60";
  }
  Astro.response.headers.set("Cache-Control", cacheControl);
  const ifNoneMatch = Astro.request.headers.get("If-None-Match");
  if (ifNoneMatch && ifNoneMatch === etag) {
    // Mirror the 200-path cache headers on the 304 so shared/browser
    // caches don't lose the policy on revalidation.
    const not304Headers: Record<string, string> = {
      ETag: etag,
      "Cache-Control": cacheControl,
    };
    if (passwordGated) {
      not304Headers["Vary"] = "Cookie";
    }
    return new Response(null, { status: 304, headers: not304Headers });
  }
} else {
  Astro.response.headers.set("Cache-Control", "private, no-store");
}

const sidebarUser = actor.user ?? {
  id: "guest",
  email: "guest@local",
  displayName: "Guest",
};
const { ctx: folderCtx } = await buildServiceContext({
  cookies: Astro.cookies,
  request: Astro.request,
  workspaceId: folder.workspaceId,
});
let workspaceRecord;
try {
  workspaceRecord = await workspacesService.get(folderCtx, {
    workspaceId: folder.workspaceId,
  });
} catch {
  workspaceRecord = null;
}
const sidebarWorkspace = workspaceRecord ?? {
  id: folder.workspaceId,
  name: "Workspace",
  slug: "workspace",
  versionRetentionDays: null,
  createdAt: folder.createdAt,
  updatedAt: folder.updatedAt,
};
const sidebarWorkspaces =
  !isPublicPublication && actor.user
    ? await workspacesService.listForUser(folderCtx, { userId: actor.user.id })
    : [];

const workspaceFolders = await foldersService.listAll(folderCtx, {
  workspaceId: folder.workspaceId,
});
const ancestorIds = await foldersService.ancestorPath(folderCtx, folder.id);
const foldersById = new Map(workspaceFolders.map((node) => [node.id, node]));
const ancestorFolders = ancestorIds
  .map((id) => foldersById.get(id))
  .filter((node): node is (typeof workspaceFolders)[number] => Boolean(node));
const publicRootFolder =
  folderAccess.publication?.resourceType === "folder"
    ? await foldersService.get(folderCtx, folderAccess.publication.resourceId)
    : isPublicPublication
      ? folder
      : null;
const publicFolderPrefix = publicRootFolder
  ? `${publicRootFolder.path}/`
  : null;
const visibleFolders = isPublicPublication
  ? publicRootFolder
    ? workspaceFolders.filter(
        (node) =>
          node.id === publicRootFolder.id ||
          node.path.startsWith(publicFolderPrefix!),
      )
    : [folder]
  : await listVisibleFoldersForActor(actor, folder.workspaceId);
// Pre-resolve per-page permissions so the synchronous filter callback
// stays simple. `Promise.all` keeps the resolves parallel.
const allFolderPages = await pagesService.list(folderCtx, folder.workspaceId);
const pagePermissions = isPublicPublication
  ? new Map<string, boolean>()
  : new Map(
      await Promise.all(
        allFolderPages.map(
          async (page) =>
            [
              page.id,
              hasPermission(
                await resolveActorPermission({ actor, page }),
                "read",
              ),
            ] as const,
        ),
      ),
    );
const workspacePages = allFolderPages
  .filter((page) =>
    isPublicPublication
      ? Boolean(
          page.folderPath &&
          (page.folderPath === publicRootFolder?.path ||
            page.folderPath.startsWith(publicFolderPrefix ?? "")),
        )
      : pagePermissions.get(page.id) === true,
  )
  .sort(
    (left, right) =>
      left.folderPath.localeCompare(right.folderPath) ||
      left.title.localeCompare(right.title),
  );

const childFolders = visibleFolders.filter(
  (node) => node.parentFolderId === folder.id,
);
const childPages = workspacePages.filter(
  (page) => page.folderPath === folder.path,
);
const threadCounts = new Map<string, number>();
for (const page of childPages) {
  const threads = await commentsService.listForPage(folderCtx, {
    pageId: page.id,
    status: "open",
  });
  threadCounts.set(page.id, threads.length);
}
const listRows = [
  ...childFolders.map((node) => ({
    kind: "folder" as const,
    id: node.id,
    name: node.name,
    href: `/f/${node.slugId}`,
    threadCount: 0,
    author: null,
    updatedAt: node.updatedAt,
    childCount:
      workspaceFolders.filter((sub) => sub.parentFolderId === node.id).length +
      workspacePages.filter((page) => page.folderPath === node.path).length,
  })),
  ...childPages.map((page) => ({
    kind: "page" as const,
    id: page.id,
    name: page.title,
    href: `/p/${page.slugId}`,
    threadCount: threadCounts.get(page.id) ?? 0,
    author: null,
    updatedAt: page.updatedAt,
    childCount: 0,
  })),
];

const MAX_BREADCRUMB_SUBMENU_DEPTH = 6;

function childrenOf(
  folderPath: string,
  parentId: string | null,
  depth = 0,
): BreadcrumbSibling[] {
  const pages = workspacePages
    .filter((page) => page.folderPath === folderPath)
    .map(
      (page) =>
        ({
          id: page.id,
          name: page.title,
          href: `/p/${page.slugId}`,
          isCurrent: false,
          isFolder: false,
        }) satisfies BreadcrumbSibling,
    );
  const subFolders = visibleFolders
    .filter((node) =>
      parentId
        ? node.parentFolderId === parentId
        : node.parentFolderId === null,
    )
    .map(
      (node) =>
        ({
          id: node.id,
          name: node.name,
          href: `/f/${node.slugId}`,
          isCurrent: node.id === currentFolderId,
          isFolder: true,
          children:
            depth < MAX_BREADCRUMB_SUBMENU_DEPTH
              ? childrenOf(node.path, node.id, depth + 1)
              : [],
        }) satisfies BreadcrumbSibling,
    );
  return [...subFolders, ...pages];
}

const segments: BreadcrumbSegment[] = ancestorFolders
  .filter((node) =>
    isPublicPublication && publicRootFolder
      ? node.id === publicRootFolder.id ||
        node.path.startsWith(publicFolderPrefix!)
      : true,
  )
  .map((node, index, list) => {
    const isCurrent = node.id === folder.id;
    return {
      id: node.id,
      name: node.name,
      href: `/f/${node.slugId}`,
      isCurrent,
      siblings: childrenOf(node.path, node.parentFolderId).filter(
        (sibling) => !isCurrent || sibling.id !== folder.id,
      ),
      allChildrenHref:
        index === list.length - 1 ? `/f/${node.slugId}` : undefined,
    } satisfies BreadcrumbSegment;
  });

const workspaceHref = workspaceRecord
  ? `/app?workspace_id=${encodeURIComponent(sidebarWorkspace.id)}`
  : "/app";
const sidebarPages = workspacePages.map((page) => ({
  id: page.id,
  slugId: page.slugId,
  title: page.title,
  folderPath: page.folderPath || null,
}));
const sidebarPageIds = new Set(sidebarPages.map((page) => page.id));
const initialFavoriteIds =
  actor.user && !isPublicPublication
    ? (
        await favoritesService.listForWorkspace(folderCtx, {
          workspaceId: sidebarWorkspace.id,
        })
      )
        .map((favorite) => favorite.pageId)
        .filter((pageId) => sidebarPageIds.has(pageId))
    : [];
const sidebarFoldersForTree = visibleFolders.map((node) => ({
  id: node.id,
  slugId: node.slugId,
  name: node.name,
  path: node.path,
  parentFolderId: node.parentFolderId,
}));
const sidebarTreeVersion = isPublicPublication
  ? null
  : (await buildWorkspaceNavigation(actor, sidebarWorkspace.id)).treeVersion;

const canWrite =
  !isPublicPublication &&
  hasPermission(await resolveFolderActorPermission({ actor, folder }), "write");
const canManageAccess = hasPermission(folderAccess.permission, "admin");
const publicIndexable = Boolean(
  folderAccess.publication?.indexingEnabled &&
  !folderAccess.publication.passwordHash,
);
---

<AppLayout
  title={`${folder.name} - VegaStack Pages`}
  robots={publicIndexable ? "index,follow" : "noindex"}
  initialTheme={readInitialTheme(Astro.cookies)}
>
  {
    passwordPrompt ? (
      <SharePasswordPrompt
        client:load
        publicationId={passwordPrompt.publicationId}
        workspaceId={folder.workspaceId}
      />
    ) : (
      <div
        class:list={[
          "vpg-shell",
          "vpg-shell--has-mtab",
          isPublicPublication && "vpg-shell--public-share",
        ]}
      >
        {!isPublicPublication && (
          <Sidebar
            workspace={{
              id: sidebarWorkspace.id,
              name: sidebarWorkspace.name,
              slug: sidebarWorkspace.slug,
            }}
            workspaces={sidebarWorkspaces.map((w) => ({
              id: w.id,
              name: w.name,
              slug: w.slug,
            }))}
            currentUser={sidebarUser}
            pages={sidebarPages}
            folders={sidebarFoldersForTree}
            canWrite={canWrite}
            currentFolderId={folder.id}
            initialFavoriteIds={initialFavoriteIds}
            treeVersion={sidebarTreeVersion}
          />
        )}
        {isPublicPublication && publicRootFolder && (
          <PublicFolderSidebar
            rootFolderId={publicRootFolder.id}
            currentFolderId={folder.id}
            folders={sidebarFoldersForTree}
            pages={sidebarPages}
          />
        )}

        <div class="vpg-shell-right">
          <PageHeader
            workspaceId={sidebarWorkspace.id}
            workspaceName={sidebarWorkspace.name}
            workspaceHref={workspaceHref}
            segments={segments}
            pageId={folder.id}
            resourceType="folder"
            slugId={folder.slugId}
            title={folder.name}
            sourceType="markdown"
            canEdit={false}
            canExportSource={false}
            canComment={false}
            canFavorite={false}
            canManageAccess={canManageAccess}
            showNavigationToggle={!isPublicPublication}
            updatedAt={folder.updatedAt}
          />

          <div class="vpg-shell-body">
            <main class="vpg-shell-main">
              <article class="vpg-shell-article prose-article">
                {/* Shell swap zone — same contract as /p/* routes. */}
                <div
                  id="vpg-document"
                  class="vpg-document-zone"
                  data-vpg-document
                >
                  <p class="prose-eyebrow">Folder</p>
                  <h1 class="prose-title">{folder.name}</h1>

                  <FolderPageList
                    rows={listRows}
                    workspaceId={sidebarWorkspace.id}
                    folderId={folder.id}
                    canWrite={canWrite}
                  />
                </div>
              </article>
            </main>
          </div>
        </div>

        {!isPublicPublication && (
          <CommandPalette client:idle workspaceId={sidebarWorkspace.id} />
        )}

        {!isPublicPublication && (
          <MobileTabBar
            pageId={undefined}
            showComments={false}
            commentsBadge={0}
          />
        )}
      </div>
    )
  }

  {/* Shell controller activation deferred — see /p/[slugId].astro. */}
</AppLayout>
