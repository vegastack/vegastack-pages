---
import SettingsLayout from "../layouts/SettingsLayout.astro";
import { loadSettings, formatDate } from "../lib/settings-data";

export const prerender = false;

const result = await loadSettings(Astro);
if (result.kind === "redirect") return result.response;
const { workspaces, currentUser } = result.context;
---

<SettingsLayout
  title={`Profile · ${currentUser.displayName} · VegaStack Pages`}
  context={result.context}
  currentSection="profile"
  sectionLabel={currentUser.displayName}
  description={`Signed in as ${currentUser.email}. Identity is used for review comments, audit logs, and agent-connected sessions.`}
>
  <form slot="actions" method="post" action="/api/auth/logout">
    <button class="vpg-button vpg-button-default vpg-button-md" type="submit">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        width="14"
        height="14"
        aria-hidden="true"
      >
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
        <polyline points="16 17 21 12 16 7"></polyline>
        <line x1="21" x2="9" y1="12" y2="12"></line>
      </svg>
      <span>Log out</span>
    </button>
  </form>

  <section class="settings-card" aria-labelledby="profile-identity-h">
    <header class="settings-card-header">
      <h2 id="profile-identity-h">Identity</h2>
      <p>Details attached to your activity in this workspace.</p>
    </header>
    <dl class="metadata-list">
      <div>
        <dt>User ID</dt><dd>
          <code class="settings-code-path">{currentUser.id}</code>
        </dd>
      </div>
      <div>
        <dt>Role</dt><dd>
          <span class="settings-pill">{currentUser.role}</span>
        </dd>
      </div>
      <div><dt>Created</dt><dd>{formatDate(currentUser.createdAt)}</dd></div>
    </dl>
  </section>

  <section
    class="settings-card settings-card-table"
    aria-labelledby="profile-workspaces-h"
  >
    <header class="settings-card-header">
      <h2 id="profile-workspaces-h">Workspaces</h2>
      <p>Workspaces you can open with this session.</p>
    </header>
    <div class="settings-table-wrap">
      <table class="settings-table">
        <thead>
          <tr>
            <th>Workspace</th>
            <th>Slug</th>
            <th class="settings-actions-cell" aria-label="Actions"></th>
          </tr>
        </thead>
        <tbody>
          {
            workspaces.length === 0 ? (
              <tr>
                <td colspan="3">
                  <div class="settings-empty">
                    <div class="settings-empty-glyph" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <>
                          <rect x="3" y="5" width="18" height="14" rx="2" />
                          <path d="M3 10h18" />
                        </>
                      </svg>
                    </div>
                    <p>
                      <strong>No workspaces yet</strong>You will see workspaces
                      here once an admin invites you, or you complete instance
                      setup.
                    </p>
                  </div>
                </td>
              </tr>
            ) : (
              workspaces.map((ws) => (
                <tr>
                  <td>{ws.name}</td>
                  <td>
                    <code class="settings-code-path">{ws.slug}</code>
                  </td>
                  <td class="settings-actions-cell">
                    <a href={`/app/settings/general?workspace_id=${ws.id}`}>
                      Open settings
                    </a>
                  </td>
                </tr>
              ))
            )
          }
        </tbody>
      </table>
    </div>
  </section>
</SettingsLayout>
