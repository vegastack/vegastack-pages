<AppLayout
  title={`${title} - VegaStack Pages`}
  robots={publicIndexable ? "index,follow" : "noindex"}
  initialTheme={readInitialTheme(Astro.cookies)}
>
  {
    passwordPrompt ? (
      <SharePasswordPrompt
        client:load
        publicationId={passwordPrompt.publicationId}
        workspaceId={pageWithSource.page.workspaceId}
      />
    ) : (
      <div class={shellClasses} data-vpg-workspace-id={sidebarWorkspace.id}>
        {!isPublicPublication && (
          <Sidebar
            transition:persist="vpg-sidebar"
            workspace={{
              id: sidebarWorkspace.id,
              name: sidebarWorkspace.name,
              slug: sidebarWorkspace.slug,
            }}
            workspaces={sidebarWorkspaces.map((w) => ({
              id: w.id,
              name: w.name,
              slug: w.slug,
            }))}
            currentUser={sidebarUser}
            pages={sidebarPages}
            folders={sidebarFoldersForTree}
            canWrite={canWrite}
            currentPageId={pageWithSource.page.id}
            initialFavoriteIds={initialFavoriteIds}
            treeVersion={sidebarTreeVersion}
          />
        )}
        {isPublicPublication && publicRootFolder && (
          <PublicFolderSidebar
            rootFolderId={publicRootFolder.id}
            currentPageId={pageWithSource.page.id}
            folders={sidebarFoldersForTree}
            pages={sidebarPages}
          />
        )}

        <div class="vpg-shell-right">
          {inTrash && (
            <div class="page-trash-banner" role="status">
              <p>
                This page is in the trash. It will be permanently deleted 30
                days after it was moved.
              </p>
              <form
                method="post"
                action={`/api/pages/${pageWithSource.page.id}/restore`}
              >
                <button type="submit" class="page-trash-banner-cta">
                  Restore page
                </button>
              </form>
            </div>
          )}
          <PageHeader
            transition:persist="vpg-page-header"
            workspaceId={sidebarWorkspace.id}
            workspaceName={sidebarWorkspace.name}
            workspaceHref={workspaceHref}
            segments={segments}
            pageId={pageWithSource.page.id}
            slugId={pageWithSource.page.slugId}
            title={title}
            sourceType={pageWithSource.page.sourceType}
            canEdit={canWrite}
            canExportSource={canExportSource}
            canComment={canComment}
            canManageAccess={canManageAccess}
            showNavigationToggle={!isPublicPublication}
            canFavorite={Boolean(actor.user)}
            initialFavorited={initialFavoriteIds.includes(
              pageWithSource.page.id,
            )}
            commentsBadge={initialCommentStats.open}
            headings={displayedHeadings}
            updatedAt={pageWithSource.page.updatedAt}
          />

          <div class="vpg-shell-body">
            <main class="vpg-shell-main">
              <article
                class:list={[
                  "vpg-shell-article",
                  isHtmlPage ? "html-article" : "prose-article",
                ]}
                data-vpg-page-editor={canWrite ? "true" : undefined}
                data-page-id={canWrite ? pageWithSource.page.id : undefined}
                data-page-title={canWrite ? title : undefined}
                data-source-type={
                  canWrite ? pageWithSource.page.sourceType : undefined
                }
                data-guest-name-required={
                  canWrite ? String(pageAccess.guestNameRequired) : undefined
                }
                data-workspace-id={sidebarWorkspace.id}
              >
                {/* Shell swap zone: the workspace shell controller replaces
                    the inner HTML of this div on /p/* and /f/* navigation.
                    The article wrapper persists with its data-* attributes
                    so the editor host below stays mounted across nav. */}
                <div
                  id="vpg-document"
                  class="vpg-document-zone"
                  data-vpg-document
                >
                  {!isHtmlPage && <h1 class="prose-title">{title}</h1>}
                  {description && (
                    <p class="prose-description" data-vpg-description-static>
                      {description}
                    </p>
                  )}

                  {metadataEntries.length > 0 && (
                    <dl
                      class="metadata-list"
                      aria-label="Page metadata"
                      data-vpg-metadata-static
                    >
                      {metadataEntries.map(([key, value]) => (
                        <div>
                          <dt>{humanizeFrontmatterKey(key)}</dt>
                          <dd>
                            {typeof value === "string"
                              ? value
                              : JSON.stringify(value)}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  )}

                  {pageWithSource.page.sourceType === "html" ? (
                    <iframe
                      class="html-preview"
                      data-vpg-html-static
                      data-vpg-comments-nonce={commentsBridgeNonce}
                      sandbox="allow-scripts"
                      srcdoc={htmlPreviewSrcdoc}
                      title={title}
                    />
                  ) : (
                    <div
                      class="prose"
                      data-context="app"
                      data-vpg-prose
                      data-vpg-prose-static
                      set:html={displayedHtml}
                    />
                  )}
                </div>
                {canWrite && <div data-vpg-editor-host hidden />}
              </article>
            </main>
            {canComment && (
              <CommentsRail
                client:idle
                transition:persist="vpg-comments-rail"
                workspaceId={sidebarWorkspace.id}
                pageId={pageWithSource.page.id}
                contentHash={pageWithSource.page.contentHash}
                sourceType={pageWithSource.page.sourceType}
                guestNameRequired={pageAccess.guestNameRequired}
                currentUserName={sidebarUser.displayName}
                initialStats={initialCommentStats}
                initialExpanded={commentsRailInitialExpanded}
              />
            )}
          </div>
        </div>

        {!isPublicPublication && (
          <CommandPalette
            client:idle
            transition:persist="vpg-command-palette"
            workspaceId={sidebarWorkspace.id}
          />
        )}

        {!isPublicPublication && (
          <MobileTabBar
            transition:persist="vpg-mobile-tabbar"
            pageId={pageWithSource.page.id}
            showComments={canComment}
            commentsBadge={initialCommentStats.open}
          />
        )}
      </div>
    )
  }

  {
    /* Prose / editor / TOC initializers live in AppLayout.astro so
      they run uniformly on every ClientRouter view transition. */
  }
</AppLayout>
