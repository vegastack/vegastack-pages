---
import { pages, setup } from "@vegastack/pages-services";
import AppLayout from "../../layouts/AppLayout.astro";
import { buildServiceContext } from "../../lib/service-context";
import { readInitialTheme } from "../../lib/theme";

export const prerender = false;

const { ctx } = await buildServiceContext({
  cookies: Astro.cookies,
  request: Astro.request,
});
const status = await setup.status(ctx);
const setupWorkspacePages = status.firstWorkspaceId
  ? await pages.list(ctx, status.firstWorkspaceId)
  : [];
const setupRedirect = setupWorkspacePages[0]
  ? `/p/${setupWorkspacePages[0].slugId}`
  : "/";
const initialTheme = readInitialTheme(Astro.cookies);
---

<AppLayout title="Setup - VegaStack Pages" initialTheme={initialTheme}>
  <main class="auth-shell">
    <section class="auth-form-side" aria-labelledby="setup-heading">
      <header>
        <a class="auth-wordmark" href="/">VegaStack Pages</a>
      </header>
      <h1 id="setup-heading">Instance setup</h1>
      <p>
        Create the first admin and workspace. Public signup stays disabled after
        setup.
      </p>

      {
        status.setupComplete ? (
          <div class="setup-complete">
            <p>Setup is complete.</p>
            <a class="toolbar-button primary" href={setupRedirect}>
              Open workspace
            </a>
          </div>
        ) : (
          <form
            class="setup-form"
            method="post"
            action="/api/setup/complete"
            data-setup-form
          >
            <label>
              Setup token
              <input
                name="setup_token"
                required
                value={import.meta.env.DEV ? "dev-setup-token" : ""}
              />
            </label>
            <div class="form-group">
              <label>
                Admin email
                <input
                  name="admin_email"
                  required
                  type="email"
                  placeholder="admin@example.com"
                />
              </label>
              <label>
                Admin name
                <input name="admin_name" required placeholder="Admin" />
              </label>
            </div>
            <label>
              Workspace name
              <input name="workspace_name" required placeholder="Team Docs" />
            </label>
            <button class="toolbar-button primary" type="submit">
              Complete setup
            </button>
            <div
              class="auth-status"
              data-setup-result
              hidden
              role="status"
              aria-live="polite"
            />
          </form>
        )
      }
    </section>
    <aside class="auth-aside" aria-hidden="true">
      <div>
        <p class="auth-aside-eyebrow">First run</p>
        <h2 class="auth-aside-headline">
          One-time setup, then this page is gone for good.
        </h2>
        <div class="auth-aside-body">
          <p>
            The setup endpoint is open only until the first admin claims it.
            After that, signup is invite-only by default.
          </p>
          <p>
            The admin you create here owns the first workspace and can invite
            the rest of the team.
          </p>
        </div>
        <div class="auth-env-block" aria-label="Server environment hint">
          <div class="auth-env-comment"># required on the server</div>
          <div>
            <span class="auth-env-key">VPG_SETUP_TOKEN</span>=<span
              class="auth-env-val">••••••••</span
            >
          </div>
        </div>
      </div>
      <p class="auth-aside-footer">
        Rotate <code>VPG_SETUP_TOKEN</code> after first use. It is single-purpose,
        not a session secret.
      </p>
    </aside>
  </main>

  <script>
    // Progressive enhancement: the form's <form method="post"> action
    // still works without JS (the server returns a 303 redirect). When
    // JS is available we intercept to show inline loading + error UX
    // and avoid the full-page reload on success.
    const form = document.querySelector("[data-setup-form]");
    const result = document.querySelector("[data-setup-result]");

    function renderStatus(state: string, title: string, message: string) {
      if (!(result instanceof HTMLElement)) return;
      result.hidden = false;
      result.dataset.state = state;
      const titleEl = document.createElement("strong");
      titleEl.className = "auth-status-title";
      titleEl.textContent = title;
      const messageEl = document.createElement("span");
      messageEl.className = "auth-status-body";
      messageEl.textContent = message;
      result.replaceChildren(titleEl, messageEl);
    }

    form?.addEventListener("submit", async (event) => {
      if (!(form instanceof HTMLFormElement)) return;
      event.preventDefault();
      const button = form.querySelector("button[type='submit']");
      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
        button.textContent = "Creating workspace...";
      }
      renderStatus(
        "loading",
        "Setting up",
        "Creating the first admin and workspace.",
      );
      const data = new FormData(form);
      try {
        const response = await fetch("/api/setup/complete", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            setup_token: data.get("setup_token"),
            admin_email: data.get("admin_email"),
            admin_name: data.get("admin_name"),
            workspace_name: data.get("workspace_name"),
          }),
        });
        const payload = (await response.json().catch(() => ({}))) as {
          redirect_to?: string;
          error?: { message?: string };
        };
        if (!response.ok) {
          throw new Error(payload?.error?.message || "Setup failed.");
        }
        renderStatus(
          "success",
          "Setup complete",
          "Redirecting to your new workspace…",
        );
        window.location.assign(payload.redirect_to ?? "/app");
      } catch (error) {
        renderStatus(
          "error",
          "Setup failed",
          error instanceof Error ? error.message : "Setup failed.",
        );
      } finally {
        if (button instanceof HTMLButtonElement) {
          button.disabled = false;
          button.textContent = "Complete setup";
        }
      }
    });
  </script>
</AppLayout>
