---
import { publicSignupEnabled } from "../../lib/deployment";
import { getRequestActor } from "../../lib/access";
import { loginRedirectTarget } from "../../lib/auth-redirects";
import { readInitialTheme } from "../../lib/theme";
import AppLayout from "../../layouts/AppLayout.astro";

export const prerender = false;
const signupEnabled = publicSignupEnabled();
const isDev = import.meta.env.DEV;
const actor = await getRequestActor(Astro.cookies);
if (actor.user) {
  return Astro.redirect(
    loginRedirectTarget(Astro.url.searchParams.get("redirect_to")),
  );
}
const initialTheme = readInitialTheme(Astro.cookies);
---

<AppLayout title="Log in - VegaStack Pages" initialTheme={initialTheme}>
  <main class="auth-shell">
    <section class="auth-form-side" aria-labelledby="login-heading">
      <header>
        <a class="auth-wordmark" href="/">VegaStack Pages</a>
      </header>
      <h1 id="login-heading">Log in</h1>
      <p>
        Enter the email an admin invited. We will send you a one-time sign-in
        link.{
          isDev && (
            <>
              {" "}
              Demo admin in dev: <code>admin@example.com</code>.
            </>
          )
        }
      </p>
      <form
        class="login-form"
        data-login-form
        method="post"
        action="/api/auth/magic-link/request"
        onsubmit="event.preventDefault();return false;"
      >
        <label>
          Email address
          <input
            name="email"
            type="email"
            autocomplete="email"
            required
            value={isDev ? "admin@example.com" : ""}
            placeholder="you@example.com"
          />
        </label>
        <button class="toolbar-button primary" type="submit"
          >Email me a sign-in link</button
        >
      </form>
      {
        signupEnabled && (
          <p class="auth-alt">
            New workspace? <a href="/app/signup">Create one</a>
          </p>
        )
      }
      {
        isDev && (
          <a class="dev-login-link" href="/api/auth/dev-login">
            Skip the email and sign in directly (dev only)
          </a>
        )
      }
      <div
        class="auth-status"
        data-login-result
        data-dev-mode={isDev ? "true" : "false"}
        hidden
        role="status"
        aria-live="polite"
      >
      </div>
    </section>
    <aside class="auth-aside" aria-hidden="true">
      <div>
        <p class="auth-aside-eyebrow">Sign-in</p>
        <h2 class="auth-aside-headline">No passwords. One link.</h2>
        <div class="auth-aside-body">
          <p>
            We email you a short-lived sign-in link. No passwords to rotate, no
            SSO to wire up before the first page ships.
          </p>
          <p>
            Invites are scoped to a workspace. Public signup stays off unless
            you turn it on.
          </p>
        </div>
        {
          isDev ? (
            <div class="auth-env-block" aria-label="Dev hint">
              <div class="auth-env-comment">
                # in dev the link prints to your server logs
              </div>
              <div class="auth-env-prompt">tail -f vegastack-pages.log</div>
            </div>
          ) : (
            <div class="auth-env-block" aria-label="Sign-in details">
              <div>
                <span class="auth-env-key">link</span>{" "}
                <span class="auth-env-val">short-lived and single use</span>
              </div>
              <div>
                <span class="auth-env-key">access</span>{" "}
                <span class="auth-env-val">workspace membership required</span>
              </div>
            </div>
          )
        }
      </div>
      <p class="auth-aside-footer">
        {
          isDev
            ? "No email after a minute? Check the server logs."
            : "No email after a minute? Check spam, then ask your workspace admin to confirm the invite."
        }
      </p>
    </aside>
  </main>
  <script>
    const form = document.querySelector("[data-login-form]");
    const result = document.querySelector("[data-login-result]");
    const params = new URLSearchParams(window.location.search);
    const redirectTo = params.get("redirect_to");

    function renderStatus(
      state: string,
      title: string,
      message: string,
      action?: HTMLElement | null,
    ) {
      if (!(result instanceof HTMLElement)) return;
      result.hidden = false;
      result.dataset.state = state;
      const titleEl = document.createElement("strong");
      titleEl.className = "auth-status-title";
      titleEl.textContent = title;
      const messageEl = document.createElement("span");
      messageEl.className = "auth-status-body";
      messageEl.textContent = message;
      const children: HTMLElement[] = [titleEl, messageEl];
      if (action) children.push(action);
      result.replaceChildren(...children);
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const button = form.querySelector("button[type='submit']");
      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
        button.textContent = "Sending...";
      }
      renderStatus(
        "loading",
        "Sending link",
        "We are preparing a one-time sign-in link for this email address.",
      );
      const data = new FormData(form);
      const body: Record<string, unknown> = { email: data.get("email") };
      if (redirectTo) body.redirect_to = redirectTo;
      try {
        const response = await fetch("/api/auth/magic-link/request", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(body),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(payload?.error?.message || "Sign-in link failed.");
        }
        let action: HTMLAnchorElement | null = null;
        if (
          result instanceof HTMLElement &&
          result.dataset.devMode === "true" &&
          payload?.debug_verify_url
        ) {
          action = document.createElement("a");
          action.href = String(payload.debug_verify_url);
          action.textContent = "Open development sign-in link";
        }
        renderStatus(
          "success",
          "Check your email",
          "If this address has access, a sign-in link is on the way.",
          action,
        );
      } catch (error) {
        renderStatus(
          "error",
          "Could not send link",
          error instanceof Error ? error.message : "Sign-in link failed.",
        );
      } finally {
        if (button instanceof HTMLButtonElement) {
          button.disabled = false;
          button.textContent = "Email me a sign-in link";
        }
      }
    });
    const devLink = document.querySelector(
      "a.dev-login-link",
    ) as HTMLAnchorElement | null;
    if (devLink && redirectTo) {
      const devUrl = new URL(devLink.href, window.location.origin);
      devUrl.searchParams.set("redirect_to", redirectTo);
      devLink.href = devUrl.toString();
    }
  </script>
</AppLayout>
