---
// Sessions split into two settings pages (My Connections + Workspace
// Connections) in 0.2.0. Preserve the legacy route + the legacy `?view=`
// query so old bookmarks land on the right surface.
import { legacySessionsRedirect } from "../../../lib/settings-redirects";

export const prerender = false;

return Astro.redirect(
  legacySessionsRedirect(Astro.url.searchParams.get("view")),
  301,
);
---
