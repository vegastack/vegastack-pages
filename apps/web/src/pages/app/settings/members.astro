---
import { users, workspaces } from "@vegastack/pages-services";
import SettingsLayout from "../../../layouts/SettingsLayout.astro";
import { loadSettings } from "../../../lib/settings-data";
import { buildServiceContext } from "../../../lib/service-context";
import { InviteMemberDialog } from "../../../components/settings/InviteMemberDialog";
import { WorkspaceMembersManager } from "../../../components/settings/WorkspaceMembersManager";

export const prerender = false;

const result = await loadSettings(Astro);
if (result.kind === "redirect") return result.response;
const { workspace, currentUser } = result.context;
const { ctx } = await buildServiceContext({
  cookies: Astro.cookies,
  request: Astro.request,
  workspaceId: workspace.id,
});
const memberRows = await workspaces.listMembers(ctx, {
  workspaceId: workspace.id,
});
const members = await Promise.all(
  memberRows.map(async (item) => {
    const user = await users.getById(ctx, item.userId);
    return {
      ...item,
      user: user
        ? {
            id: user.id,
            email: user.email,
            displayName: user.displayName ?? user.email,
            role: user.role,
          }
        : null,
    };
  }),
);
const openInviteOnLoad = Astro.url.searchParams.get("focus") === "invite";
---

<SettingsLayout
  title={`Members · ${workspace.name} · VegaStack Pages`}
  context={result.context}
  currentSection="members"
  sectionLabel="Members"
  description="People with access to this workspace. Roles control read, comment, and edit permissions across all pages."
>
  <InviteMemberDialog
    slot="actions"
    client:load
    workspaceId={workspace.id}
    openOnLoad={openInviteOnLoad}
  />

  <WorkspaceMembersManager
    client:load
    workspaceId={workspace.id}
    currentUserId={currentUser.id}
    initialMembers={members}
  />
</SettingsLayout>
