---
import {
  permissions as permissionsService,
  users,
  workspaces,
} from "@vegastack/pages-services";
import SettingsLayout from "../../../../layouts/SettingsLayout.astro";
import { formatDate, loadSettings } from "../../../../lib/settings-data";
import { listMcpSessions } from "../../../../lib/runtime";
import { buildServiceContext } from "../../../../lib/service-context";
import { vendorForClient } from "../../../../lib/oauth/vendor-map";

export const prerender = false;

const result = await loadSettings(Astro);
if (result.kind === "redirect") return result.response;
const { workspace, currentUser } = result.context;

const { ctx } = await buildServiceContext({
  cookies: Astro.cookies,
  request: Astro.request,
  workspaceId: workspace.id,
});

// Admin-only surface. A non-admin landing here (typed URL, bookmark, copied
// link from an admin) is bounced to their personal connections view; the
// silent-tab-redirect anti-pattern from the old combined page is gone.
const member = await workspaces.getMember(ctx, {
  workspaceId: workspace.id,
  userId: currentUser.id,
});
const permission = await permissionsService.resolve(ctx, {
  workspaceId: workspace.id,
  userId: currentUser.id,
  scope: "workspace",
  targetId: workspace.id,
  memberRole: member?.role ?? null,
  instanceRole: currentUser.role,
});
if (permission !== "admin") {
  return Astro.redirect("/app/settings/connections", 303);
}

const sessions = await listMcpSessions({ workspaceId: workspace.id });

type Card = {
  id: string;
  vendorLabel: string;
  clientName: string;
  sessionSuffix: string;
  kind: string;
  ownerDisplayName: string;
  ownerEmail: string;
  ownerInitials: string;
  isCurrentUser: boolean;
  lastSeen: string;
  created: string;
  expires: string;
};

function initialsOf(name: string): string {
  return (
    name
      .split(/\s+/)
      .map((part) => part[0] ?? "")
      .join("")
      .slice(0, 2)
      .toUpperCase() || "?"
  );
}

const cards: Card[] = await Promise.all(
  sessions.map(async (session) => {
    const vendor = vendorForClient({
      clientName: session.clientName,
      redirectUris: null,
    });
    const owner = await users.getById(ctx, session.userId);
    const displayName = owner?.displayName ?? owner?.email ?? "Unknown user";
    const email = owner?.email ?? "—";
    return {
      id: session.id,
      vendorLabel: vendor.label,
      clientName: session.clientName,
      sessionSuffix: session.id.slice(-6),
      kind: session.kind ?? "manual",
      ownerDisplayName: displayName,
      ownerEmail: email,
      ownerInitials: initialsOf(displayName),
      isCurrentUser: session.userId === currentUser.id,
      lastSeen: session.lastSeenAt ? formatDate(session.lastSeenAt) : "Never",
      created: formatDate(session.createdAt),
      expires: formatDate(session.expiresAt),
    };
  }),
);
---

<SettingsLayout
  title={`Connections Log · ${workspace.name} · VegaStack Pages`}
  context={result.context}
  currentSection="connections_workspace"
  sectionLabel="Connections Log"
  description="Every active connection any member has open against this workspace. Admins can revoke any token here; members manage their own from My Connections."
>
  {
    cards.length === 0 ? (
      <section class="settings-card settings-card-table">
        <div class="settings-empty">
          <div class="settings-empty-glyph" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 22v-5" />
              <path d="M9 7V2" />
              <path d="M15 7V2" />
              <path d="M6 13V8a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v5a6 6 0 0 1-12 0Z" />
            </svg>
          </div>
          <p>
            <strong>No active connections</strong>
            <span>
              MCP clients and CLI tokens from every workspace member appear
              here. Nobody has connected yet.
            </span>
          </p>
        </div>
      </section>
    ) : (
      <ul class="connections-log-list" role="list">
        {cards.map((card) => (
          <li class="connections-log-card" data-mcp-session-row={card.id}>
            <header class="connections-log-card-head">
              <div class="connections-log-card-client">
                <div class="connections-log-card-client-line">
                  <span class="settings-chip settings-chip-vendor">
                    {card.vendorLabel}
                  </span>
                  <span class="connections-log-client-name">
                    {card.clientName}
                  </span>
                </div>
                <code class="settings-code-path connections-log-session-code">
                  Session {card.sessionSuffix}
                </code>
              </div>
              <div class="connections-log-card-head-right">
                <span class="settings-chip">{card.kind}</span>
                <button
                  class="settings-row-action danger"
                  type="button"
                  data-revoke-mcp-session={card.id}
                  aria-label={`Revoke ${card.ownerDisplayName}'s ${card.clientName} connection`}
                  title="Revoke connection"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M3 6h18" />
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                    <line x1="10" x2="10" y1="11" y2="17" />
                    <line x1="14" x2="14" y1="11" y2="17" />
                  </svg>
                </button>
              </div>
            </header>
            <footer class="connections-log-card-foot">
              <div class="connections-log-card-owner">
                <span class="settings-owner-avatar" aria-hidden="true">
                  {card.ownerInitials}
                </span>
                <div class="connections-log-card-owner-meta">
                  <div class="connections-log-card-owner-name">
                    <span>{card.ownerDisplayName}</span>
                    {card.isCurrentUser && (
                      <span class="settings-chip settings-chip-subtle">
                        You
                      </span>
                    )}
                  </div>
                  <small class="settings-muted-line">{card.ownerEmail}</small>
                </div>
              </div>
              <dl class="connections-log-card-meta">
                <div>
                  <dt>Last seen</dt>
                  <dd>{card.lastSeen}</dd>
                </div>
                <div>
                  <dt>Created</dt>
                  <dd>{card.created}</dd>
                </div>
                <div>
                  <dt>Expires</dt>
                  <dd>{card.expires}</dd>
                </div>
              </dl>
            </footer>
          </li>
        ))}
      </ul>
    )
  }

  <script
    is:inline
    define:vars={{
      workspaceId: workspace.id,
    }}
  >
    (() => {
      const { toast, confirmAction, withTransition } = window.settingsHelpers;
      function cookie(name) {
        return document.cookie
          .split(";")
          .map((part) => part.trim())
          .find((part) => part.startsWith(name + "="))
          ?.slice(name.length + 1);
      }
      function csrfHeaders(extra) {
        return Object.assign({}, extra, {
          "x-vpg-csrf-token": decodeURIComponent(cookie("vpg_csrf") || ""),
        });
      }

      function fadeOut(node, after) {
        node.dataset.leaving = "true";
        const reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        window.setTimeout(after, reduce ? 0 : 220);
      }

      document.addEventListener("click", async (event) => {
        const target =
          event.target instanceof Element
            ? event.target.closest("[data-revoke-mcp-session]")
            : null;
        if (!target) return;
        const sessionId = target.getAttribute("data-revoke-mcp-session");
        if (!sessionId) return;
        const confirmed = await confirmAction({
          title: "Revoke connection",
          description:
            "The client using this token will lose access immediately. The owner can create a new connection from their My Connections page.",
          confirmLabel: "Revoke connection",
          tone: "danger",
        });
        if (!confirmed) return;
        const card = target.closest("[data-mcp-session-row]");
        if (card) card.dataset.pending = "true";
        const response = await fetch("/api/mcp/sessions", {
          method: "DELETE",
          headers: csrfHeaders({ "content-type": "application/json" }),
          body: JSON.stringify({
            workspace_id: workspaceId,
            session_id: sessionId,
          }),
        });
        if (response.ok) {
          if (card) {
            withTransition(() => fadeOut(card, () => card.remove()));
          }
          toast("Connection revoked.");
        } else {
          if (card) delete card.dataset.pending;
          toast("Could not revoke connection.", "error");
        }
      });
    })();
  </script>
</SettingsLayout>

<style is:global>
  .connections-log-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }
  .connections-log-card {
    background: var(--vsk-surface-elevated, var(--vsk-surface));
    border: var(--vsk-line);
    border-radius: var(--vsk-radius-lg, 12px);
    padding: var(--space-md) var(--space-lg);
    transition:
      opacity var(--motion-base) var(--ease-out),
      transform var(--motion-base) var(--ease-out);
  }
  .connections-log-card[data-leaving="true"] {
    opacity: 0;
    transform: translateY(-2px);
  }
  .connections-log-card[data-pending="true"] {
    opacity: 0.55;
    pointer-events: none;
  }

  .connections-log-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: var(--vsk-line);
  }
  .connections-log-card-client {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }
  .connections-log-card-client-line {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-width: 0;
  }
  .settings-chip-vendor {
    flex: 0 0 auto;
    background: var(--vsk-surface);
    border: var(--vsk-line);
    color: var(--vsk-text);
    font-size: 0.6875rem;
    padding: 0.1rem 0.45rem;
    text-transform: none;
    letter-spacing: 0;
  }
  .connections-log-client-name {
    font-size: var(--text-sm, 0.875rem);
    color: var(--vsk-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  .connections-log-session-code {
    align-self: start;
    margin-top: 0.15rem;
    font-size: 0.6875rem;
  }
  .connections-log-card-head-right {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    flex: 0 0 auto;
  }

  .connections-log-card-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: var(--space-md);
    align-items: start;
    padding-top: var(--space-sm);
  }
  @media (max-width: 720px) {
    .connections-log-card-foot {
      grid-template-columns: 1fr;
    }
  }

  .connections-log-card-owner {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-width: 0;
  }
  .connections-log-card-owner-meta {
    min-width: 0;
    display: grid;
    line-height: 1.3;
  }
  .connections-log-card-owner-name {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    min-width: 0;
  }
  .connections-log-card-owner-name > span:not(.settings-chip) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    font-size: var(--text-sm, 0.875rem);
    color: var(--vsk-text);
  }
  .connections-log-card-owner-name > .settings-chip {
    flex: 0 0 auto;
  }
  .connections-log-card-owner-meta > small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .connections-log-card-meta {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-sm) var(--space-md);
    font-size: var(--text-sm);
  }
  @media (max-width: 540px) {
    .connections-log-card-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .connections-log-card-meta > div {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .connections-log-card-meta dt {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--vsk-muted);
    margin: 0;
  }
  .connections-log-card-meta dd {
    margin: 0;
    color: var(--vsk-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Reused by the avatar inside the card. The selector lives here so the
     workspace.astro file doesn't have to duplicate the avatar style from the
     old table layout. */
  .settings-owner-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--vsk-radius-circle);
    background: var(--vsk-surface);
    border: var(--vsk-line);
    color: var(--vsk-text-80);
    font-size: var(--text-xs);
    font-weight: 600;
    flex: 0 0 auto;
  }
  .settings-chip-subtle {
    background: var(--vsk-surface-elevated, transparent);
    border: var(--vsk-line);
    color: var(--vsk-muted);
    font-size: 0.6875rem;
    padding: 0.05rem 0.4rem;
  }
</style>
