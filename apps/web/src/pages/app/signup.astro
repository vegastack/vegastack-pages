---
import { getRequestActor } from "../../lib/access";
import { loginRedirectTarget } from "../../lib/auth-redirects";

export const prerender = false;
const actor = getRequestActor(Astro.cookies);
if (actor.user) {
  return Astro.redirect(
    loginRedirectTarget(Astro.url.searchParams.get("redirect_to")),
  );
}
return Astro.rewrite(`/signup${Astro.url.search}`);
---
